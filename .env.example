# Required for Gemini AI style direction. If empty, the local couture engine is used.
GEMINI_API_KEY=

# Public URL of this app (https://your-domain.com). Used for self-referential links.
APP_URL=

# HTTP port. Most hosts inject PORT automatically.
PORT=3000

# Bind address. Keep 0.0.0.0 on a VPS / Docker.
HOST=0.0.0.0

# Optional local JSON fallback folder (ignored when Supabase is configured).
# DATA_DIR=/var/lib/margo-atelier

# --- Supabase (REQUIRED in production / Vercel) ---
# Project URL from Supabase → Project Settings → API
SUPABASE_URL=
# service_role key (server only — never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=

# Telegram Bot Token from @BotFather for consultation notifications.
TELEGRAM_BOT_TOKEN=

# Telegram chat or channel ID where dossiers are delivered.
TELEGRAM_CHAT_ID=

# WhatsApp Cloud API (Meta) — optional
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# E.164 digits only, no +
WHATSAPP_NOTIFY_TO=

# Inbox that receives a copy of every consultation dossier.
ADMIN_EMAIL=

# SMTP for dossier emails (required for email delivery).
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# Password for Atelier admin console (REQUIRED locally and in production).
# No default in code — set a strong unique value. Never commit the real password.
ADMIN_PASSWORD=

# PayPal (Virtual Try-On payments in ZAR)
# Create a REST app at https://developer.paypal.com/dashboard/applications
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox | live
PAYPAL_MODE=sandbox
